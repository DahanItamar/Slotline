{
  "name": "@slotline/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "provision": "tsx src/db/provision-roles.ts",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "prune": "tsx src/jobs/prune.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@node-rs/argon2": "^1.8.3",
    "@slotline/shared": "*",
    "fastify": "^4.28.1",
    "kysely": "^0.27.4",
    "luxon": "^3.5.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "uuidv7": "^1.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.17.0",
    "vitest": "^2.0.5"
  }
}
