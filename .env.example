# ---------------------------------------------------------------------------
# TEMPLATE ONLY — this file contains no real values and never should.
#
#   cp .env.example .env      then edit .env, which is gitignored.
#
# Every variable below is parsed and validated by apps/api/src/config/env.ts at
# boot. A missing or malformed one stops the process before it listens, so a
# misconfigured deploy fails loudly during the rollout rather than quietly on
# the first request that needed it.
#
# Replace every CHANGEME. Nothing here works until you do.
# ---------------------------------------------------------------------------


# --- Database -------------------------------------------------------------
#
# Three connection strings, three different database roles, on purpose. The
# separation is the tenant-isolation boundary (see docs/SPEC.md §9), not a
# convention — do not point them all at the same superuser.
#
# Create the two application roles first:
#   APP_TENANT_ROLE_PASSWORD=... APP_AUTH_ROLE_PASSWORD=... npm run provision
# Then use those same two passwords below.

# Role: app_tenant. Carries every ordinary query. Row-level security applies to
# it, so a query that forgets its tenant scope returns nothing rather than
# another organisation's rows.
APP_DATABASE_URL=postgres://app_tenant:CHANGEME@localhost:5432/slotline

# Role: app_auth. Used by exactly one module, for the sign-in lookups that
# happen before a tenant is known. It owns tenants/users/sessions and holds no
# privilege at all on bookings or resources.
APP_AUTH_DATABASE_URL=postgres://app_auth:CHANGEME@localhost:5432/slotline

# Schema owner. Used only by `npm run migrate` and `npm run provision`, never
# by the running server. Needs superuser or CREATEROLE for provisioning.
APP_MIGRATION_DATABASE_URL=postgres://app_owner:CHANGEME@localhost:5432/slotline


# --- Application ----------------------------------------------------------

# The public origin the app is served from. Two things depend on it: mutating
# requests carrying a different Origin header are refused, and the session
# cookie is marked Secure when APP_NODE_ENV is production.
#   development : http://localhost:5173   (the Vite dev server)
#   production  : https://your-domain.example
APP_ORIGIN=http://localhost:5173

# Port the API listens on. In production the same process also serves the
# built SPA, so this is the only port you need to expose.
APP_PORT=3000

# fatal | error | warn | info | debug | trace | silent
APP_LOG_LEVEL=info

# development | test | production
# production also enables Secure cookies, JSON logs, and the daily retention job.
APP_NODE_ENV=development
